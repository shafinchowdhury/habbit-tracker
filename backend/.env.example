# HabitQuest Backend Environment Configuration

# Database
# For SQLite (default development):
DATABASE_URL=sqlite+aiosqlite:///./habitquest.db

# For PostgreSQL (production, e.g., Neon / Supabase / Render):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Security
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated list or JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://yourdomain.com","https://*.pages.dev"]
